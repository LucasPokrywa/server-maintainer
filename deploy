#!/bin/bash

set -e

usage() {
    cat <<EOF
Usage: $0 [options]

Options:
  -s, --selinux    Ajouter le tag selinux
  -m, --monitor    Ajouter le tag monitor
  -a, --all        Lancer tous les tags
  -b, --backup     Ajouter systeme de backup
  -d, --debug      Lancer avec le debug
  -h, --help       Afficher cette aide

EOF
}

TAGS="ssh,cron,ports,packages"

VERBOSITY=""

add_tag() {
    [[ ",$TAGS," != *",$1,"* ]] && TAGS="$TAGS,$1"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--selinux)
            add_tag selinux
        ;;
        -m|--monitor)
            add_tag monitor
        ;;
        -a|--all)
            add_tag selinux
            add_tag monitor
        ;;
        -b|--backup)
            add_tag backup
        ;;
        -d|--debug)
            shift
            
            if [[ -z "$1" ]]; then
                echo "Erreur : -d attend une valeur entre 1 et 3."
                exit 1
            fi
            
            case "$1" in
                1)
                    VERBOSITY="-v"
                ;;
                2)
                    VERBOSITY="-vv"
                ;;
                3)
                    VERBOSITY="-vvv"
                ;;
                *)
                    echo "Erreur : la valeur de -d doit être 1, 2 ou 3."
                    exit 1
                ;;
            esac
        ;;
        -h|--help)
            usage
            exit 0
        ;;
        *)
            echo "Option inconnue : $1"
            usage
            exit 1
        ;;
    esac
    shift
done

if [ ! -f ".env" ]; then
    echo "Erreur : fichier .env absent. Copiez .env.example vers .env et renseignez les identifiants."
    exit 1
fi

set -a
source .env
set +a

REQUIRED_ENV_VARS=(
    MANAGED_SERVERS_ANSIBLE_USER
    MANAGED_SERVERS_ANSIBLE_PASSWORD
    BACKUP_SERVERS_ANSIBLE_USER
    BACKUP_SERVERS_ANSIBLE_PASSWORD
    SSH_PUBLIC_KEY_PATH
)

for var_name in "${REQUIRED_ENV_VARS[@]}"; do
    if [ -z "${!var_name:-}" ]; then
        echo "Erreur : la variable $var_name est absente ou vide dans .env."
        exit 1
    fi
done

if [ ! -d ".venv" ]; then
    python3 -m venv .venv
fi

source .venv/bin/activate

pip install -r requirements.txt

ansible-galaxy collection install -r requirements.yml

ansible-playbook ${VERBOSITY:+$VERBOSITY} \
-i inventory.yaml \
playbook.yaml \
-t "$TAGS"
